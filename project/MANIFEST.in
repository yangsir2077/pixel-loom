include README.md README.en.md LICENSE CHANGELOG.md CONTRIBUTING.md CONTRIBUTORS.md SECURITY.md THIRD_PARTY_NOTICES.md
include setup.ps1 launch.ps1 mcp_server.py AGENTS.md CLAUDE.md requirements.txt
include .gitignore 打开像素织机.cmd
include tools/build_release.py tools/package_windows.py tools/package_handoff.py tools/frozen_entry.py tools/windows.spec
include integrations/connect.py integrations/codex.toml integrations/claude-desktop.json
recursive-include pixel_workbench/resources *
# Reset old cached source manifests before selecting maintained documentation.
prune docs
include docs/USER_GUIDE.md docs/AI_GUIDE.md docs/ARCHITECTURE.md docs/RELEASE.md docs/operations.schema.json
recursive-include skills *.md
recursive-include tests *.py
recursive-include .github *.yml
prune .runtime
prune .venv
prune .codex
prune assets
prune projects
prune art
prune research
exclude integrations/registration-status.json
